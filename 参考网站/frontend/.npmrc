# npm install optimization for Vercel deployment
# Prevents SIGKILL errors due to memory constraints

# Use a faster registry
registry=https://registry.npmmirror.com

# Reduce memory usage
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=30000

# Optimize installation
prefer-offline=true
audit=false
fund=false

# Ignore scripts (faster install)
ignore-scripts=false

# Maximum number of concurrent operations
maxsockets=3

# Reduce network timeouts
network-timeout=60000
