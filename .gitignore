.wrangler/

# 环境变量 - 这些是机密，别tm发出去
.env
.env*.local
.env.development
.env.test
.env.production

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

