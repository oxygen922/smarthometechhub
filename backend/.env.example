# ==========================================
# SmartHome TechHub - Environment Variables
# ==========================================
# 复制此文件为 .env 并填入你的实际API密钥
# Copy this file to .env and fill in your actual API keys

# ==========================================
# DeepSeek AI Configuration
# ==========================================
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# ==========================================
# Image API Configuration
# ==========================================
# Pexels API - Get free key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API - Get free key from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ==========================================
# Cloudflare R2 Configuration
# ==========================================
# Get your credentials from: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=smarthometechhub
R2_PUBLIC_URL=https://pub-a6a4ae7f5151464cb2be257af37faafe.r2.dev

# ==========================================
# API Server Configuration
# ==========================================
API_PORT=3003
NODE_ENV=development

# ==========================================
# RSS Feed Sources (Optional)
# ==========================================
# Add RSS feed URLs for automated content collection
# RSS_SOURCES=https://example.com/feed1,https://example.com/feed2

# ==========================================
# Content Generation Settings
# ==========================================
# Target audience region (affects content style)
TARGET_REGION=US

# Default article language
DEFAULT_LANGUAGE=en

# Maximum articles to generate per run
MAX_ARTICLES_PER_RUN=3
